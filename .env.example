# ==============================================================================
# Paper Note - Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Clerk Authentication
# Obtain these keys from your Clerk Dashboard: https://dashboard.clerk.com
# ------------------------------------------------------------------------------
# Frontend publishable key (e.g., pk_test_...)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Backend publishable key (same as VITE_CLERK_PUBLISHABLE_KEY)
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Backend secret key (e.g., sk_test_...)
# If left blank or containing placeholder text, the backend runs in dev bypass mode (user: dev_user).
CLERK_SECRET_KEY=your_clerk_secret_key

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Database host:
# - Use "localhost" when running the backend directly on your host machine
# - Use "postgres" when running via docker-compose (set automatically in docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=default
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# Port for the Express backend server (and mapped docker port)
PORT=8080

# ------------------------------------------------------------------------------
# Frontend Configuration (Optional)
# ------------------------------------------------------------------------------
# Backend API base URL when running frontend separately with Vite dev server (defaults to http://localhost:8080)
VITE_API_URL=http://localhost:8080
